# ─── Stripe (cards / Apple Pay / Google Pay / Afterpay) ────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret — set after creating webhook endpoint in Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Coinbase Commerce (crypto) ────────────────────────────────────────
# Get from https://commerce.coinbase.com/settings → API keys
COINBASE_COMMERCE_API_KEY=
# Webhook shared secret (set in Coinbase Commerce dashboard)
COINBASE_COMMERCE_WEBHOOK_SECRET=

# ─── Resend (transactional email) ──────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sender (must be a domain you've verified in Resend)
ORDER_FROM_EMAIL=orders@aeonco.com.au
ORDER_TO_EMAIL=hello@aeonco.com.au

# ─── Bank transfer (just display details in checkout) ──────────────────
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=AEON Longevity Pty Ltd
NEXT_PUBLIC_BANK_BSB=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_PAYID=hello@aeonco.com.au

# ─── Site config ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aeonco.com.au
